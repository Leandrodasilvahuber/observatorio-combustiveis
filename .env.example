AWS_REGION=us-east-1

# LocalStack: 4.14.0 roda sem conta; versões 2026.x exigem token
LOCALSTACK_VERSION=4.14.0
LOCALSTACK_AUTH_TOKEN=

# Postgres (troque as senhas)
POSTGRES_PASSWORD=troque-me
AIRFLOW_DB_PASSWORD=troque-me-tambem
POSTGRES_PORT=5432

# Home local (mapa) em http://localhost:HOME_PORT e ID fixo da Function URL
# no LocalStack: http://API_URL_ID_LOCAL.lambda-url.<região>.localhost.localstack.cloud:4566/
HOME_PORT=8000
API_URL_ID_LOCAL=observatorio

# Bucket do projeto. No LocalStack o account id é sempre 000000000000.
OBS_BUCKET=observatorio-dev-000000000000

# Perfil usado nos comandos contra a AWS real (make plan-aws / deploy-aws)
AWS_PROFILE=observatorio-dev
